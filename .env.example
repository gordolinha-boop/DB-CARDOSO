# Configuração pública do projeto Supabase.
# Valores abaixo são apenas exemplos e não conectam a um projeto real.
# No Supabase, use Project URL e a chave publicável (sb_publishable_...).
# A chave publicável/anon pode estar no frontend somente com RLS habilitado.
# NUNCA coloque service_role, secret key, senha ou chave privada em variáveis VITE_*.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_exemplo-nao-utilizar
